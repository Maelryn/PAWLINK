NODE_ENV=development
PORT=4000

# Supabase → Connect → Postgres.
# SUPABASE_DB_URL = DIRECT connection (port 5432) — used by `prisma migrate`.
# DATABASE_URL     = SESSION POOLER connection — used at runtime.
# If the direct host times out on Windows/IPv4, use the session pooler for both and report it.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Auth — generate your own: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
JWT_ISSUER=pawlink

# Comma-separated. Vercel domain goes here when deployed.
CORS_ORIGINS=http://localhost:3000

# SMS: console (default, prints the OTP — demo works offline) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AI: mock (default, offline) | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=

# Uploads: leave empty to get a typed "uploads not configured" error
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

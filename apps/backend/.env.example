NODE_ENV=development
PORT=4000

# Supabase → Connect → Postgres.
# SUPABASE_DB_URL = DIRECT connection — used by `prisma migrate`.
# DATABASE_URL     = SESSION POOLER connection — used at runtime.
#
# Both were verified against a real project (Tier B). Two things are easy to get
# wrong and produce an error the message does not explain:
#
#   1. the POOLER username carries the project ref: `postgres.PROJECT_REF`, not
#      `postgres`. Without it Supavisor answers
#      "no tenant identifier provided (external_id or sni_hostname required)".
#   2. the SESSION pooler is port **5432** on the pooler host. Port 6543 is the
#      TRANSACTION pooler, which breaks Prisma's prepared statements — the spec
#      asks for the session pooler for exactly that reason.
#
# If the direct host times out on Windows/IPv4, use the pooler for both too.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Auth — generate your own: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
JWT_ISSUER=pawlink

# Comma-separated. Vercel domain goes here when deployed.
CORS_ORIGINS=http://localhost:3000

# SMS: console (default, prints the OTP — demo works offline) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Uploads: leave empty to get a typed "uploads not configured" error
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

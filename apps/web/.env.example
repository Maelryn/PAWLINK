# Copy to .env.local (never committed). Leave both empty to run on the demo database.

# The PawLink API (apps/backend, NestJS). Local: http://localhost:4000
NEXT_PUBLIC_API_URL=

# Which parts of the app use the real API, comma separated. Turn one on when its backend phase is live:
#   auth (Phase 1) · cases, uploads, ai (Phase 2) · adoptions, services, notifications (Phase 3) · admin (Phase 4)
NEXT_PUBLIC_API_FEATURES=
